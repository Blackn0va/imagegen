root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{md,markdown}]
trim_trailing_whitespace = false   # zwei Leerzeichen am Zeilenende = Umbruch

[*.{json,yml,yaml,toml}]
indent_size = 2

# PowerShell: CRLF und UTF-8 mit BOM sind Pflicht, sonst scheitert
# Windows PowerShell 5.1 an den Umlauten (siehe .gitattributes).
[*.ps1]
end_of_line = crlf
charset = utf-8-bom

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
